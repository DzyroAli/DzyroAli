# ── Slaydchibot environment ─────────────────────────────────────────────
# Copy to .env.local for development. Everything is optional: without
# Supabase/bot token the app runs in "guest mode" and stores projects
# in the browser's localStorage.

# --- Telegram bot (required in production) ------------------------------
# 1. Create a bot via https://t.me/BotFather → /newbot
# 2. Paste the token here. It is used server-side to verify the Mini App
#    initData signature (never exposed to the browser).
TELEGRAM_BOT_TOKEN=

# --- Supabase (project storage) ------------------------------------------
# https://supabase.com/dashboard → Project Settings → API.
# Only the service-role key is needed: all DB access goes through
# Next.js API routes, the browser never talks to Supabase directly.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Session -------------------------------------------------------------
# Secret for signing the auth cookie. If empty, a secret is derived from
# TELEGRAM_BOT_TOKEN. Set explicitly if you ever rotate the bot token.
SESSION_SECRET=

# --- Misc ----------------------------------------------------------------
# Public URL of the deployed app (used in metadata), e.g. https://slaydchibot.vercel.app
NEXT_PUBLIC_APP_URL=
