# --- Site ---
NEXT_PUBLIC_SITE_URL=https://techradar.uz

# --- Supabase (https://supabase.com/dashboard → Project Settings → API) ---
# Leave empty to run the UI in demo mode with sample data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server only, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google OAuth ---
# Set to "true" ONLY after enabling the Google provider in Supabase
# (Dashboard → Authentication → Providers → Google). Otherwise the button
# is hidden so users don't hit "provider is not enabled".
NEXT_PUBLIC_GOOGLE_ENABLED=

# --- Telegram Login (https://t.me/BotFather) ---
# 1. Create a bot with @BotFather
# 2. Run /setdomain and point it to your site domain
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# --- Email notifications (https://resend.com) ---
# Optional. If unset, comment notifications are silently skipped.
# EMAIL_FROM must be a verified sender, e.g. "TechRadar.uz <hi@techradar.uz>".
RESEND_API_KEY=
EMAIL_FROM=
