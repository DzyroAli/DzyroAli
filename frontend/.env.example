# --- Site ---
NEXT_PUBLIC_SITE_URL=https://techradar.uz

# --- Supabase (https://supabase.com/dashboard → Project Settings → API) ---
# Leave empty to run the UI in demo mode with sample data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server only, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Telegram Login (https://t.me/BotFather) ---
# 1. Create a bot with @BotFather
# 2. Run /setdomain and point it to your site domain
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
